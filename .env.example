# NEXORA Application Configuration
# Copy this file to .env and fill in your values

# Database Configuration
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_secure_password_123
POSTGRES_DB=nexora_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Neo4j Configuration
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexora_neo4j_password_123
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_PROTOCOL=bolt

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production_to_long_random_string
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8080/api
REACT_APP_NEO4J_URL=http://localhost:7474

# Logging
LOG_LEVEL=INFO
SPRING_JPA_SHOW_SQL=false

# File Upload
FILE_UPLOAD_MAX_SIZE=52428800
FILE_UPLOAD_DIR=/app/uploads

# Email Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@nexora.com

# Application Profile
SPRING_PROFILES_ACTIVE=dev
