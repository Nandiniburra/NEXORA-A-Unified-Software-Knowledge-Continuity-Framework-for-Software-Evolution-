# Backend Environment Configuration

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nexora_db
SPRING_DATASOURCE_USERNAME=nexora
SPRING_DATASOURCE_PASSWORD=nexora_secure_password_123
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

SPRING_NEO4J_URI=bolt://neo4j:7687
SPRING_NEO4J_AUTHENTICATION_USERNAME=neo4j
SPRING_NEO4J_AUTHENTICATION_PASSWORD=nexora_neo4j_password_123

JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION=86400000

SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_NEXORA=DEBUG

SPRING_PROFILES_ACTIVE=dev
